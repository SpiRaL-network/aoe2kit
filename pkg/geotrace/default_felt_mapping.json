  "florida_region_favoring": {
    "note": "chrae 2026-09-15: FL is palm-dominant by raw population BUT is KNOWN for wetlands — favor the signature species over the merely-numerous. Bias weights when a cell could plausibly host several.",
    "coast": {
      "favor": [
        "mangrove-beach",
        "sandy-beach"
      ],
      "rule": "chrae v3: coast is STILL green-meets-water in places; it should be ALMOST UNIVERSALLY SAND (or mangrove where brackish). Widen the sand band so no green terrain touches open water, and palms have a shore to sit on."
    },
    "interior_deep": {
      "favor": [
        {
          "c": 2567,
          "s": "live oak"
        },
        {
          "c": 349,
          "s": "oak"
        }
      ],
      "note": "OAK FOREST deep in the state — favor oak hammock inland, not palm"
    },
    "wetland": {
      "favor": [
        {
          "c": 1144,
          "s": "mangrove"
        },
        {
          "c": 1350,
          "s": "reeds/sawgrass"
        }
      ],
      "note": "mangrove + sawgrass carry the Everglades — the soul of FL"
    },
    "palm_downweight": {
      "factor": 0.8,
      "note": "chrae 2026-09-15 v3: x0.5 overshot -> ZERO palms visible. Palms are the SIGNATURE of the sandy barrier coast; keep them THERE (just not inland-dominant). x0.8, and ensure sandy coast is broad enough to host them."
    }

// Caller: fontInit(); fontLoadTables(); then draw APIs. Slots 0..12, <=32 glyphs.
// Return count on success, -1 invalid input, -2 unsupported removal, -3 engine failure.
// Calls are synchronous; scratch is shared. No arbitrary Unicode or negative numbers.
float fontAspect = 2.0;
int gOrientation = 180;
int gMirror = 1;
int fontSlotOrientation = -1;
int fontSlotMirror = -1;
int fontRows = -1;
int fontStrokeX = -1;
int fontStrokeY = -1;
int fontStrokeOffsets = -1;
int fontStrokeCounts = -1;
int fontStrokeHaloX = -1;
int fontStrokeHaloY = -1;
int fontStrokeHaloOffsets = -1;
int fontStrokeHaloCounts = -1;
int fontLetters = -1;
int fontLetterIDs = -1;
int fontMessages = -1;
int fontMessageLengths = -1;
int fontScratch = -1;
int fontScratchCount = 0;
int fontCells = -1;
int fontSlotX = -1;
int fontSlotY = -1;
int fontSlotScale = -1;
int fontSlotAspect = -1;
int fontSlotMaterial = -1;
int fontSlotTable = -1;
int fontAdded = 0;
int fontRemoved = 0;
int fontKept = 0;
int fontFailures = 0;
int fontTracked = 0;
int fontPeak = 0;
int fontCellBudget = 10000;
// Non-fire adapter: dedicated gaia-only 16x16 kill zone, 4096 parking cells.
// Caller supplies one-shot remove_object triggers variable==1..N and calls
// fontSweepTick once per second. No fallback deletion or off-map pileup.
int fontSweepVariable = -1;
int fontSweepLimit = 0;
int fontSweepCount = 0;
int fontSweepTime = -1;
float fontKillX = 100.0;
float fontKillY = 100.0;
int fontRetired = -1;
int fontRetireHead = 0;
int pathPointX = -1;
int pathPointY = -1;
int pathPointCount = 0;
int pathCells = -1;
int pathTracked = -1;
void fontInit() {
  if (fontRows >= 0) return;
  fontRows = xsArrayCreateInt(1056,0,"fontRows");
  fontStrokeX = xsArrayCreateFloat(16384,0.0,"fontStrokeX");
  fontStrokeY = xsArrayCreateFloat(16384,0.0,"fontStrokeY");
  fontStrokeOffsets = xsArrayCreateInt(66,0,"fontStrokeOffsets");
  fontStrokeCounts = xsArrayCreateInt(66,0,"fontStrokeCounts");
  fontStrokeHaloX = xsArrayCreateFloat(4096,0.0,"fontStrokeHaloX");
  fontStrokeHaloY = xsArrayCreateFloat(4096,0.0,"fontStrokeHaloY");
  fontStrokeHaloOffsets = xsArrayCreateInt(66,0,"fontStrokeHaloOffsets");
  fontStrokeHaloCounts = xsArrayCreateInt(66,0,"fontStrokeHaloCounts");
  fontLetters = xsArrayCreateString(40,"","fontLetters");
  fontLetterIDs = xsArrayCreateInt(40,-1,"fontLetterIDs");
  fontMessages = xsArrayCreateInt(224,-1,"fontMessages");
  fontMessageLengths = xsArrayCreateInt(7,0,"fontMessageLengths");
  fontScratch = xsArrayCreateInt(32,-1,"fontScratch");
  fontCells = xsArrayCreateInt(13,-1,"fontCells");
  for (slotInit = 0; < 13) { xsArraySetInt(fontCells,slotInit,xsArrayCreateInt(8192,-1,"fontSlotCells")); }
  fontSlotOrientation = xsArrayCreateInt(13,-1,"fontSlotOrientation");
  fontSlotMirror = xsArrayCreateInt(13,-1,"fontSlotMirror");
  fontSlotX = xsArrayCreateFloat(13,0.0,"fontSlotX");
  fontSlotY = xsArrayCreateFloat(13,0.0,"fontSlotY");
  fontSlotScale = xsArrayCreateFloat(13,0.0,"fontSlotScale");
  fontSlotAspect = xsArrayCreateFloat(13,0.0,"fontSlotAspect");
  fontSlotMaterial = xsArrayCreateInt(13,-1,"fontSlotMaterial");
  fontSlotTable = xsArrayCreateInt(13,-1,"fontSlotTable");
  fontRetired = xsArrayCreateInt(4096,-1,"fontRetired");
  pathPointX = xsArrayCreateFloat(4096,0.0,"pathPointX");
  pathPointY = xsArrayCreateFloat(4096,0.0,"pathPointY");
  pathCells = xsArrayCreateInt(13,-1,"pathCells");
  pathTracked = xsArrayCreateInt(13,0,"pathTracked");
  for (pathSlot = 0; < 13) { xsArraySetInt(pathCells,pathSlot,xsArrayCreateInt(8192,-1,"pathSlotCells")); }
}
bool fontFire(int material = -1) { return ((material >= 939) && (material <= 942)); }
void fontConfigureSweep(int variableID = -1, int seconds = 0, float x = 100.0, float y = 100.0) {
  fontSweepVariable = variableID; fontSweepLimit = seconds; fontKillX = x; fontKillY = y;
}
void fontSweepTick() {
  int nowTime = xsGetGameTime();
  if (nowTime == fontSweepTime) return;
  fontSweepTime = nowTime;
  if (fontSweepVariable < 0) return;
  if (fontSweepCount >= fontSweepLimit) return;
  fontSweepCount = fontSweepCount + 1;
  xsSetTriggerVariable(fontSweepVariable,fontSweepCount);
}
bool fontRetire(int id = -1, int material = -1) {
  if (id < 0) return (true);
  if (fontFire(material)) return (xsSetUnitHitpoints(id,0.0));
  if ((fontSweepVariable < 0) || (fontSweepCount >= fontSweepLimit)) return (false);
  int oldID = xsArrayGetInt(fontRetired,fontRetireHead);
  if (oldID >= 0) { if (xsDoesUnitExist(oldID)) return (false); }
  int parkCol = fontRetireHead % 64;
  int parkRow = fontRetireHead / 64;
  float parkX = fontKillX + 0.25 * parkCol;
  float parkY = fontKillY + 0.25 * parkRow;
  bool moved = xsSetUnitPosition(id,xsVectorSet(parkX,parkY,-1.0),false);
  if (moved == false) return (false);
  xsArraySetInt(fontRetired,fontRetireHead,id);
  fontRetireHead = (fontRetireHead + 1) % 4096;
  return (true);
}
// Generic sampled path API. Coordinates are in cell-space before pathStroke
// applies scale, isometric aspect, orientation, and mirror. The path buffer is
// deliberately separate from the font tables so callers can draw arbitrary
// geometry without synthesizing glyph IDs.
int pathReset() {
  pathPointCount = 0;
  return (0);
}
int pathAppend(float x = 0.0, float y = 0.0) {
  if (pathPointCount >= 4096) return (-1);
  xsArraySetFloat(pathPointX,pathPointCount,x);
  xsArraySetFloat(pathPointY,pathPointCount,y);
  pathPointCount = pathPointCount + 1;
  return (pathPointCount);
}
int pathMove(float x = 0.0, float y = 0.0) {
  pathReset();
  return (pathAppend(x,y));
}
int pathLine(float x = 0.0, float y = 0.0) {
  if (pathPointCount <= 0) return (pathMove(x,y));
  return (pathAppend(x,y));
}
int pathQuadratic(float controlX = 0.0, float controlY = 0.0, float x = 0.0, float y = 0.0) {
  if (pathPointCount <= 0) return (pathMove(x,y));
  float startX = xsArrayGetFloat(pathPointX,pathPointCount-1);
  float startY = xsArrayGetFloat(pathPointY,pathPointCount-1);
  float t = 0.0;
  float u = 0.0;
  float px = 0.0;
  float py = 0.0;
  for (curveStep = 1; < 17) {
    t = curveStep / 16.0; u = 1.0 - t;
    px = u*u*startX + 2.0*u*t*controlX + t*t*x;
    py = u*u*startY + 2.0*u*t*controlY + t*t*y;
    if (pathAppend(px,py) < 0) return (-1);
  }
  return (pathPointCount);
}
int pathCubic(float control1X = 0.0, float control1Y = 0.0, float control2X = 0.0, float control2Y = 0.0, float x = 0.0, float y = 0.0) {
  if (pathPointCount <= 0) return (pathMove(x,y));
  float startX = xsArrayGetFloat(pathPointX,pathPointCount-1);
  float startY = xsArrayGetFloat(pathPointY,pathPointCount-1);
  float t = 0.0;
  float u = 0.0;
  float px = 0.0;
  float py = 0.0;
  for (curveStep = 1; < 25) {
    t = curveStep / 24.0; u = 1.0 - t;
    px = u*u*u*startX + 3.0*u*u*t*control1X + 3.0*u*t*t*control2X + t*t*t*x;
    py = u*u*u*startY + 3.0*u*u*t*control1Y + 3.0*u*t*t*control2Y + t*t*t*y;
    if (pathAppend(px,py) < 0) return (-1);
  }
  return (pathPointCount);
}
int pathStroke(int slot = 0, float x = 0.0, float y = 0.0, int material = 939, float scale = 0.0875, float spacing = 0.5) {
  if ((slot < 0) || (slot >= 13)) return (-1);
  if (pathPointCount <= 0) return (-1);
  if ((scale <= 0.0) || (spacing <= 0.0)) return (-1);
  if (fontAspect <= 0.0) return (-1);
  if (fontFire(material) == false) {
    if ((fontSweepVariable < 0) || (fontSweepCount >= fontSweepLimit)) return (-2);
  }
  int slotCells = xsArrayGetInt(pathCells,slot);
  int tracked = xsArrayGetInt(pathTracked,slot);
  int pathOld = -1;
  for (pathClear = 0; < 8192) {
    pathOld = xsArrayGetInt(slotCells,pathClear);
    if (pathOld >= 0) {
      if (fontRetire(pathOld,material)) { xsArraySetInt(slotCells,pathClear,-1); tracked = tracked - 1; }
      else return (-3);
    }
  }
  int emitted = 0;
  int oldCell = -1;
  int newCell = -1;
  float ax = 0.0;
  float ay = 0.0;
  float bx = 0.0;
  float by = 0.0;
  float dx = 0.0;
  float dy = 0.0;
  float distance = 0.0;
  int samples = 0;
  float ratio = 0.0;
  float across = 0.0;
  float downward = 0.0;
  float rotatedAcross = 0.0;
  float rotatedDown = 0.0;
  float px = 0.0;
  float py = 0.0;
  for (pathSegment = 0; < pathPointCount) {
    ax = xsArrayGetFloat(pathPointX,pathSegment); ay = xsArrayGetFloat(pathPointY,pathSegment);
    if (pathSegment + 1 < pathPointCount) { bx = xsArrayGetFloat(pathPointX,pathSegment+1); by = xsArrayGetFloat(pathPointY,pathSegment+1); }
    else { bx = ax; by = ay; }
    dx = bx - ax; dy = by - ay; distance = sqrt(dx*dx + dy*dy);
    samples = 1 + distance / spacing;
    if (samples < 1) samples = 1;
    for (pathSample = 0; < samples) {
      if (emitted >= 8192) return (-4);
      ratio = pathSample / (samples * 1.0);
      across = scale * (ax + (bx-ax)*ratio); downward = scale * (ay + (by-ay)*ratio);
      rotatedAcross = across; rotatedDown = downward;
      if (gOrientation == 90) { rotatedAcross = 0.0-downward; rotatedDown = across; }
      if (gOrientation == 180) { rotatedAcross = 0.0-across; rotatedDown = 0.0-downward; }
      if (gOrientation == 270) { rotatedAcross = downward; rotatedDown = 0.0-across; }
      if (gMirror == 1) rotatedAcross = 0.0-rotatedAcross;
      px = x + rotatedAcross + fontAspect*rotatedDown; py = y + rotatedAcross - fontAspect*rotatedDown;
      oldCell = xsArrayGetInt(slotCells,emitted);
      if (oldCell < 0) {
        if (tracked >= fontCellBudget) return (-3);
        newCell = xsCreateUnit(material,0,xsVectorSet(px,py,-1.0),false,false,false);
        if (newCell < 0) return (-3);
        xsArraySetInt(slotCells,emitted,newCell); tracked = tracked + 1;
      }
      emitted = emitted + 1;
    }
  }
  xsArraySetInt(pathTracked,slot,tracked);
  return (emitted);
}
// The alphabet contains ONE representative per case-equivalence class.
// Mixed input renders UPPERCASE intentionally. Use drawMessage for exact case.
int fontDecodeFolded(string text = "") {
  string prefixText = "";
  int lowerBound = 0;
  int upperBound = 0;
  int midpoint = 0;
  string candidateText = "";
  for (charIndex = 0; < 32) {
    if (prefixText == text) { fontScratchCount = charIndex; return (charIndex); }
    lowerBound = 0; upperBound = 40;
    for (searchRound = 0; < 7) {
      if (lowerBound < upperBound) {
        midpoint = (lowerBound + upperBound) / 2;
        candidateText = prefixText + xsArrayGetString(fontLetters,midpoint);
        if (candidateText <= text) lowerBound = midpoint + 1;
        else upperBound = midpoint;
      }
    }
    if (lowerBound == 0) return (-1);
    midpoint = lowerBound - 1;
    xsArraySetInt(fontScratch,charIndex,xsArrayGetInt(fontLetterIDs,midpoint));
    prefixText = prefixText + xsArrayGetString(fontLetters,midpoint);
  }
  if (prefixText == text) { fontScratchCount = 32; return (32); }
  return (-1);
}
// Width in cell pitches; unsupported text returns -1. Scratch is overwritten.
int measureText(string text = "") {
  int count = fontDecodeFolded(text);
  if (count < 0) return (-1);
  if (count == 0) return (0);
  return (count * 9 - 1);
}
int fontDraw(int slot = -1, float x = 0.0, float y = 0.0, int material = 939, float scale = 0.0875) {
  fontAdded = 0; fontRemoved = 0; fontKept = 0; fontFailures = 0;
  if ((slot < 0) || (slot >= 13)) return (-1);
  if ((scale <= 0.0) || (fontAspect <= 0.0)) return (-1);
  if ((fontScratchCount < 0) || (fontScratchCount > 32)) return (-1);
  if (fontFire(material) == false) {
    if ((fontSweepVariable < 0) || (fontSweepCount >= fontSweepLimit)) return (-2);
  }
  if (((gOrientation != 0) && (gOrientation != 90)) && ((gOrientation != 180) && (gOrientation != 270))) return (-1);
  int slotCells = xsArrayGetInt(fontCells,slot);
  bool geometryChanged = false;
  if (xsArrayGetInt(fontSlotOrientation,slot) != gOrientation) geometryChanged = true;
  if (xsArrayGetInt(fontSlotMirror,slot) != gMirror) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotX,slot) != x) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotY,slot) != y) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotScale,slot) != scale) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotAspect,slot) != fontAspect) geometryChanged = true;
  int oldMaterial = xsArrayGetInt(fontSlotMaterial,slot);
  if (oldMaterial != material) geometryChanged = true;
  int glyphID = -1;
  int bits = 0;
  int divisor = 1;
  int onBit = 0;
  int cellIndex = 0;
  int oldCell = -1;
  int newCell = -1;
  bool wanted = false;
  float across = 0.0;
  float downward = 0.0;
  float rotatedAcross = 0.0;
  float rotatedDown = 0.0;
  float px = 0.0;
  float py = 0.0;
  // On a geometry/material change clear first so failed retirements can be retried
  // with their ORIGINAL material and coordinates still attached to the slot.
  if (geometryChanged) {
    for (clearIndex = 0; < 8192) {
        cellIndex = clearIndex;
        oldCell = xsArrayGetInt(slotCells,cellIndex);
      if (oldCell >= 0) {
        if (fontRetire(oldCell,oldMaterial)) {
          xsArraySetInt(slotCells,cellIndex,-1); fontRemoved = fontRemoved + 1; fontTracked = fontTracked - 1;
        } else fontFailures = fontFailures + 1;
      }
    }
    if (fontFailures > 0) return (-3);
  }
  xsArraySetFloat(fontSlotX,slot,x); xsArraySetFloat(fontSlotY,slot,y);
  xsArraySetFloat(fontSlotScale,slot,scale); xsArraySetFloat(fontSlotAspect,slot,fontAspect);
  xsArraySetInt(fontSlotMaterial,slot,material);
  xsArraySetInt(fontSlotOrientation,slot,gOrientation);
  xsArraySetInt(fontSlotMirror,slot,gMirror);
  for (letter = 0; < 32) {
    glyphID = -1;
    if (letter < fontScratchCount) glyphID = xsArrayGetInt(fontScratch,letter);
    for (row = 0; < 16) {
      bits = 0;
      if (glyphID >= 0) bits = xsArrayGetInt(fontRows,glyphID * 16 + row);
      divisor = 1;
      for (col = 0; < 8) {
        onBit = (bits / divisor) % 2; divisor = divisor * 2;
        wanted = onBit == 1;
        cellIndex = letter * 128 + row * 8 + col;
        oldCell = xsArrayGetInt(slotCells,cellIndex);
        if ((oldCell >= 0) && (wanted == false)) {
          if (fontRetire(oldCell,material)) {
            xsArraySetInt(slotCells,cellIndex,-1); fontRemoved = fontRemoved + 1; fontTracked = fontTracked - 1;
          } else fontFailures = fontFailures + 1;
        }
        if ((oldCell >= 0) && wanted) fontKept = fontKept + 1;
        if ((oldCell < 0) && wanted) {
          across = scale * (letter * 9 + col);
          downward = scale * row;
          rotatedAcross = across; rotatedDown = downward;
          if (gOrientation == 90) { rotatedAcross = 0.0-downward; rotatedDown = across; }
          if (gOrientation == 180) { rotatedAcross = 0.0-across; rotatedDown = 0.0-downward; }
          if (gOrientation == 270) { rotatedAcross = downward; rotatedDown = 0.0-across; }
          if (gMirror == 1) rotatedAcross = 0.0-rotatedAcross;
          px = x + rotatedAcross + fontAspect*rotatedDown; py = y + rotatedAcross - fontAspect*rotatedDown;
          newCell = -1;
          if (fontTracked < fontCellBudget) newCell = xsCreateUnit(material,0,xsVectorSet(px,py,-1.0),false,false,false);
          if (newCell >= 0) {
            xsArraySetInt(slotCells,cellIndex,newCell); fontAdded = fontAdded + 1; fontTracked = fontTracked + 1;
            if (fontTracked > fontPeak) fontPeak = fontTracked;
          } else fontFailures = fontFailures + 1;
        }
      }
    }
  }
  if (fontFailures > 0) return (-3);
  return (fontScratchCount);
}
// Outline renderer: one Gaia unit per precomputed outline point. The point
// table is generated from the same font face as the bitmap fallback.
int fontStrokeDraw(int slot = -1, float x = 0.0, float y = 0.0, int material = 415, float scale = 0.0875, int tableKind = 0) {
  fontAdded = 0; fontRemoved = 0; fontKept = 0; fontFailures = 0;
  if ((slot < 0) || (slot >= 13)) return (-1);
  if ((scale <= 0.0) || (fontAspect <= 0.0)) return (-1);
  if ((tableKind < 0) || (tableKind > 1)) return (-1);
  if ((fontScratchCount < 0) || (fontScratchCount > 32)) return (-1);
  if (fontFire(material) == false) {
    if ((fontSweepVariable < 0) || (fontSweepCount >= fontSweepLimit)) return (-2);
  }
  int slotCells = xsArrayGetInt(fontCells,slot);
  bool geometryChanged = false;
  if (xsArrayGetInt(fontSlotOrientation,slot) != gOrientation) geometryChanged = true;
  if (xsArrayGetInt(fontSlotMirror,slot) != gMirror) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotX,slot) != x) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotY,slot) != y) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotScale,slot) != scale) geometryChanged = true;
  if (xsArrayGetFloat(fontSlotAspect,slot) != fontAspect) geometryChanged = true;
  if (xsArrayGetInt(fontSlotTable,slot) != tableKind) geometryChanged = true;
  int oldMaterial = xsArrayGetInt(fontSlotMaterial,slot);
  if (oldMaterial != material) geometryChanged = true;
  int cellIndex = 0;
  int oldCell = -1;
  if (geometryChanged) {
    for (clearIndex = 0; < 8192) {
      cellIndex = clearIndex; oldCell = xsArrayGetInt(slotCells,cellIndex);
      if (oldCell >= 0) {
        if (fontRetire(oldCell,oldMaterial)) {
          xsArraySetInt(slotCells,cellIndex,-1); fontRemoved = fontRemoved + 1; fontTracked = fontTracked - 1;
        } else fontFailures = fontFailures + 1;
      }
    }
    if (fontFailures > 0) return (-3);
  }
  xsArraySetFloat(fontSlotX,slot,x); xsArraySetFloat(fontSlotY,slot,y);
  xsArraySetFloat(fontSlotScale,slot,scale); xsArraySetFloat(fontSlotAspect,slot,fontAspect);
  xsArraySetInt(fontSlotMaterial,slot,material); xsArraySetInt(fontSlotOrientation,slot,gOrientation); xsArraySetInt(fontSlotMirror,slot,gMirror);
  int pointX = fontStrokeX; int pointY = fontStrokeY; int pointOffsets = fontStrokeOffsets; int pointCounts = fontStrokeCounts;
  if (tableKind == 1) { pointX = fontStrokeHaloX; pointY = fontStrokeHaloY; pointOffsets = fontStrokeHaloOffsets; pointCounts = fontStrokeHaloCounts; }
  xsArraySetInt(fontSlotTable,slot,tableKind);
  for (letter = 0; < 32) {
    int glyphID = -1;
    if (letter < fontScratchCount) glyphID = xsArrayGetInt(fontScratch,letter);
    if (glyphID < 0) continue;
    int pointCount = xsArrayGetInt(pointCounts,glyphID);
    int pointOffset = xsArrayGetInt(pointOffsets,glyphID);
    for (pointIndex = 0; < 256) {
      bool wanted = pointIndex < pointCount;
      cellIndex = letter * 256 + pointIndex;
      oldCell = xsArrayGetInt(slotCells,cellIndex);
      if ((oldCell >= 0) && (wanted == false)) {
        if (fontRetire(oldCell,material)) {
          xsArraySetInt(slotCells,cellIndex,-1); fontRemoved = fontRemoved + 1; fontTracked = fontTracked - 1;
        } else fontFailures = fontFailures + 1;
      }
      if ((oldCell >= 0) && wanted) fontKept = fontKept + 1;
      if ((oldCell < 0) && wanted) {
        float across = scale * (9.0 * letter + xsArrayGetFloat(pointX,pointOffset+pointIndex));
        float downward = scale * xsArrayGetFloat(pointY,pointOffset+pointIndex);
        float rotatedAcross = across; float rotatedDown = downward;
        if (gOrientation == 90) { rotatedAcross = 0.0-downward; rotatedDown = across; }
        if (gOrientation == 180) { rotatedAcross = 0.0-across; rotatedDown = 0.0-downward; }
        if (gOrientation == 270) { rotatedAcross = downward; rotatedDown = 0.0-across; }
        if (gMirror == 1) rotatedAcross = 0.0-rotatedAcross;
        float px = x + rotatedAcross + fontAspect*rotatedDown;
        float py = y + rotatedAcross - fontAspect*rotatedDown;
        int newCell = -1;
        if (fontTracked < fontCellBudget) newCell = xsCreateUnit(material,0,xsVectorSet(px,py,-1.0),false,false,false);
        if (newCell >= 0) {
          xsArraySetInt(slotCells,cellIndex,newCell); fontAdded = fontAdded + 1; fontTracked = fontTracked + 1;
          if (fontTracked > fontPeak) fontPeak = fontTracked;
        } else fontFailures = fontFailures + 1;
      }
    }
  }
  if (fontFailures > 0) return (-3);
  return (fontScratchCount);
}
int drawStrokeMessageTable(int slot = -1, float x = 0.0, float y = 0.0, int messageID = -1, int material = 415, float scale = 0.0875, int tableKind = 0) {
  if ((messageID < 0) || (messageID >= 7)) return (-1);
  fontScratchCount = xsArrayGetInt(fontMessageLengths,messageID);
  for (messageChar = 0; < fontScratchCount) { xsArraySetInt(fontScratch,messageChar,xsArrayGetInt(fontMessages,messageID*32+messageChar)); }
  return (fontStrokeDraw(slot,x,y,material,scale,tableKind));
}
int drawStrokeMessage(int slot = -1, float x = 0.0, float y = 0.0, int messageID = -1, int material = 415, float scale = 0.0875) {
	return (drawStrokeMessageTable(slot,x,y,messageID,material,scale,0));
}
int drawStrokeNumber(int slot = -1, float x = 0.0, float y = 0.0, int value = 0, int minDigits = 1, int material = 415, float scale = 0.2, int tableKind = 0) {
  if (value < 0) return (-1);
  if ((minDigits < 1) || (minDigits > 10)) return (-1);
  int remaining = value;
  int digits = 1;
  while (remaining >= 10) { remaining = remaining / 10; digits = digits + 1; }
  if (digits < minDigits) digits = minDigits;
  fontScratchCount = digits;
  remaining = value;
  for (digitIndex = 0; < digits) {
    int digit = remaining % 10; remaining = remaining / 10;
    xsArraySetInt(fontScratch,digits-1-digitIndex,3+digit);
  }
  return (fontStrokeDraw(slot,x,y,material,scale,tableKind));
}
int drawSentence(int slot = -1, float x = 0.0, float y = 0.0, string text = "", int material = 939, float scale = 0.0875) {
  int count = fontDecodeFolded(text);
  if (count < 0) return (-1);
  return (fontDraw(slot,x,y,material,scale));
}
int drawLetter(int slot = -1, float x = 0.0, float y = 0.0, int glyphID = -1, int material = 939, float scale = 0.0875) {
  if ((glyphID < 0) || (glyphID >= 66)) return (-1);
  fontScratchCount = 1; xsArraySetInt(fontScratch,0,glyphID);
  return (fontDraw(slot,x,y,material,scale));
}
int drawMessage(int slot = -1, float x = 0.0, float y = 0.0, int messageID = -1, int material = 939, float scale = 0.0875) {
  if ((messageID < 0) || (messageID >= 7)) return (-1);
  fontScratchCount = xsArrayGetInt(fontMessageLengths,messageID);
  for (messageChar = 0; < fontScratchCount) { xsArraySetInt(fontScratch,messageChar,xsArrayGetInt(fontMessages,messageID*32+messageChar)); }
  return (fontDraw(slot,x,y,material,scale));
}
int drawNumber(int slot = -1, float x = 0.0, float y = 0.0, int value = 0, int minDigits = 1, int material = 939, float scale = 0.0875) {
  if (value < 0) return (-1);
  if ((minDigits < 1) || (minDigits > 10)) return (-1);
  int remaining = value;
  int digits = 1;
  int place = 1;
  int digit = 0;
  while (remaining >= 10) { remaining = remaining / 10; digits = digits + 1; }
  if (digits < minDigits) digits = minDigits;
  fontScratchCount = digits;
  remaining = value;
  for (digitIndex = 0; < digits) {
    digit = remaining % 10; remaining = remaining / 10;
    xsArraySetInt(fontScratch,digits-1-digitIndex,3+digit);
  }
  return (fontDraw(slot,x,y,material,scale));
}
int clearSlot(int slot = -1) {
  if ((slot < 0) || (slot >= 13)) return (-1);
  fontScratchCount = 0;
  return (fontDraw(slot,xsArrayGetFloat(fontSlotX,slot),xsArrayGetFloat(fontSlotY,slot),xsArrayGetInt(fontSlotMaterial,slot),xsArrayGetFloat(fontSlotScale,slot)));
}
int setSentence(int slot = -1, string text = "") {
  if ((slot < 0) || (slot >= 13)) return (-1);
  return (drawSentence(slot,xsArrayGetFloat(fontSlotX,slot),xsArrayGetFloat(fontSlotY,slot),text,xsArrayGetInt(fontSlotMaterial,slot),xsArrayGetFloat(fontSlotScale,slot)));
}
int setNumber(int slot = -1, int value = 0, int minDigits = 1) {
  if ((slot < 0) || (slot >= 13)) return (-1);
  return (drawNumber(slot,xsArrayGetFloat(fontSlotX,slot),xsArrayGetFloat(fontSlotY,slot),value,minDigits,xsArrayGetInt(fontSlotMaterial,slot),xsArrayGetFloat(fontSlotScale,slot)));
}
// Parameterless trigger bridge: caller reserves variables 20(slot),21(message),22(value).
// Slot must have been drawn/configured by XS first; no string transport via variables.
void fontBridgeMessage() {
  int slot = xsTriggerVariable(20);
  int messageID = xsTriggerVariable(21);
  if ((slot < 0) || (slot >= 13)) return;
  drawMessage(slot,xsArrayGetFloat(fontSlotX,slot),xsArrayGetFloat(fontSlotY,slot),messageID,xsArrayGetInt(fontSlotMaterial,slot),xsArrayGetFloat(fontSlotScale,slot));
}
void fontBridgeNumber() { setNumber(xsTriggerVariable(20),xsTriggerVariable(22),1); }


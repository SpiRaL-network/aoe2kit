// END_GAIA_TEXT_LIBRARY

bool swatchLog = false;
int swatchLast = -1;
int swatchCounter = 0;
void main() {
  fontInit(); fontLoadTables();
	fontConfigureSweep(10, 600, 112.0, 112.0);
  swatchLog = xsCreateFile(false);
  if (swatchLog) {
    xsWriteString("GAIA_FONT_STATIC_SWEEP_V1"); xsWriteInt(1); xsWriteInt(12);
    xsWriteInt(fontAdded); xsWriteInt(fontKept); xsWriteInt(fontTracked); xsWriteInt(fontFailures);
  }
	  drawMessage(0, 92.0, 42.0, 4, 415, 0.0875);
  if (swatchLog) { xsWriteInt(0); xsWriteInt(415); xsWriteInt(fontAdded + fontKept); }
  drawMessage(1, 70.0, 42.0, 4, 809, 0.0875);
  if (swatchLog) { xsWriteInt(1); xsWriteInt(809); xsWriteInt(fontAdded + fontKept); }
  drawMessage(2, 48.0, 42.0, 4, 737, 0.0875);
  if (swatchLog) { xsWriteInt(2); xsWriteInt(737); xsWriteInt(fontAdded + fontKept); }
  drawMessage(3, 26.0, 42.0, 4, 820, 0.0875);
  if (swatchLog) { xsWriteInt(3); xsWriteInt(820); xsWriteInt(fontAdded + fontKept); }
  drawMessage(4, 92.0, 60.0, 4, 143, 0.0875);
  if (swatchLog) { xsWriteInt(4); xsWriteInt(143); xsWriteInt(fontAdded + fontKept); }
  drawMessage(5, 70.0, 60.0, 4, 144, 0.0875);
  if (swatchLog) { xsWriteInt(5); xsWriteInt(144); xsWriteInt(fontAdded + fontKept); }
  drawMessage(6, 48.0, 60.0, 4, 389, 0.0875);
  if (swatchLog) { xsWriteInt(6); xsWriteInt(389); xsWriteInt(fontAdded + fontKept); }
  drawMessage(7, 26.0, 60.0, 4, 248, 0.0875);
  if (swatchLog) { xsWriteInt(7); xsWriteInt(248); xsWriteInt(fontAdded + fontKept); }
  drawMessage(8, 92.0, 78.0, 4, 1366, 0.0875);
  if (swatchLog) { xsWriteInt(8); xsWriteInt(1366); xsWriteInt(fontAdded + fontKept); }
  drawMessage(9, 70.0, 78.0, 4, 1364, 0.0875);
  if (swatchLog) { xsWriteInt(9); xsWriteInt(1364); xsWriteInt(fontAdded + fontKept); }
  drawMessage(10, 48.0, 78.0, 4, 306, 0.0875);
  if (swatchLog) { xsWriteInt(10); xsWriteInt(306); xsWriteInt(fontAdded + fontKept); }
  drawMessage(11, 26.0, 78.0, 4, 939, 0.0875);
  if (swatchLog) { xsWriteInt(11); xsWriteInt(939); xsWriteInt(fontAdded + fontKept); }
  if (swatchLog) { xsWriteInt(fontAdded); xsWriteInt(fontKept); xsWriteInt(fontTracked); xsWriteInt(fontFailures); }
  drawNumber(12, 30.0, 80.0, 0, 2, 415, 0.0875);

}
rule materialSwatchTick
active
minInterval 1
maxInterval 1
{
  int now = xsGetGameTime();
  if (now != swatchLast) {
    swatchLast = now;
    swatchCounter = now;
    fontSweepTick();
    setNumber(12, swatchCounter, 2);
    if (swatchLog) {
      xsWriteInt(now); xsWriteInt(fontSweepCount); xsWriteInt(fontAdded); xsWriteInt(fontRemoved);
      xsWriteInt(fontKept); xsWriteInt(fontFailures); xsWriteInt(fontTracked);
      xsWriteInt(fontRetireHead); xsWriteInt(fontSweepTime);
    }
  }
  if (now >= 20) {
    if (swatchLog) { xsWriteInt(424242); xsCloseFile(); }
    xsDisableSelf();
  }
}
	